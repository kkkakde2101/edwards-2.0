# Copy to .env (never commit .env) and fill in.
# SQL Server running on this machine, reached from Docker:
EDWARDS_DB=Server=host.docker.internal,1433;Database=Edwards2;User Id=sa;Password=change-me;TrustServerCertificate=True;Encrypt=True
# At least 32 random characters, for example: openssl rand -base64 48
EDWARDS_JWT_KEY=change-me-to-a-long-random-value
